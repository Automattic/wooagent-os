# UI assets embedded into the daemon binary at build time. The placeholder
# index.html stays committed so //go:embed compiles on a fresh clone; the
# real (Vite-built) bundle lands here via scripts/build-ui-into-daemon.sh
# and shouldn't be checked in (binary churn + size).
/daemon/internal/uiassets/dist/*
!/daemon/internal/uiassets/dist/index.html

