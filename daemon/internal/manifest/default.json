      "personas": [
        "marketing",
        "pricing",
        "inventory",
        "sales-support"
      ],
      "description": "Confirm and execute a planned operation. The conflict_policy chosen at plan-batch-operation time is locked in; this ability does not accept a policy override."
    },
    {
